# --- Phase 1: required ---
DATABASE_URL=postgres://drop_tracker:drop_tracker@localhost:5432/drop_tracker?sslmode=disable
HTTP_PORT=8080
LOG_LEVEL=info      # debug|info|warn|error
LOG_FORMAT=json     # json|text — use text for local dev readability

# --- Stubbed for future phases: optional, defaults are safe placeholders ---
DISCORD_WEBHOOK_URL=
POLL_INTERVAL=15m
MUSICBRAINZ_USER_AGENT=drop-tracker/0.1.0 (+https://github.com/danielrpof/drop-tracker)  # required by MusicBrainz; never leave empty
MUSICBRAINZ_RATE_LIMIT_PER_SEC=1   # requests/sec self-throttle ceiling
DEEZER_RATE_LIMIT_PER_5S=50        # requests/5s self-throttle ceiling
EVENT_RETENTION_DAYS=90     # days of history GET /events shows; must be > 0

MUSICBRAINZ_POLL_WORKERS=3
DEEZER_POLL_WORKERS=5
NOTIFY_MAX_RELEASE_AGE_DAYS=7
